{
  "id": "./",
  "name": "Avani Loan Insurance Tracker",
  "short_name": "Loan Tracker",
  "description": "Track Axis Bank loan files with Bajaj GCPP insurance: file status, TAT, queries and monthly reports.",
  "start_url": "./#files",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f5f2",
  "theme_color": "#13233f",
  "categories": ["business", "productivity", "finance"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New file", "short_name": "New file", "url": "./#new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Monthly report", "short_name": "Report", "url": "./#report", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "photos", "accept": ["image/*"] }] }
  }
}
